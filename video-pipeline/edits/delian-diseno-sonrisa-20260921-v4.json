  "captions": [
    {
      "start": 0.221,
      "end": 0.815,
      "text": "¿Qué realmente es"
    },
    {
      "start": 0.84,
      "end": 1.78,
      "text": "un diseño de sonrisa?"
    },
    {
      "start": 2.206,
      "end": 2.855,
      "text": "Cuando pensamos en"
    },
    {
      "start": 2.88,
      "end": 3.615,
      "text": "un diseño de sonrisa,"
    },
    {
      "start": 3.64,
      "end": 4.995,
      "text": "pensamos rápidamente en"
    },
    {
      "start": 5.02,
      "end": 5.96,
      "text": "hacernos los dientes,"
    },
    {
      "start": 6.22,
      "end": 8.22,
      "text": "en carillas, en laminados,"
    },
    {
      "start": 8.799,
      "end": 9.495,
      "text": "y va mucho más"
    },
    {
      "start": 9.52,
      "end": 9.955,
      "text": "que eso."
    },
    {
      "start": 9.98,
      "end": 10.68,
      "text": "Tenemos que mirar"
    },
    {
      "start": 10.888,
      "end": 11.775,
      "text": "todo el rostro,"
    },
    {
      "start": 11.8,
      "end": 13.56,
      "text": "los labios, las encías,"
    },
    {
      "start": 13.7,
      "end": 15.12,
      "text": "sobre todo la mordida,",
      "primary_colour": "&H00E560EB"
    },
    {
      "start": 15.564,
      "end": 16.375,
      "text": "para entonces poder crear"
    },
    {
      "start": 16.4,
      "end": 17.78,
      "text": "una sonrisa armoniosa.",
      "primary_colour": "&H00E560EB"
    }
