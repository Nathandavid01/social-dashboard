  "captions": [
    {
      "start": 0.169,
      "end": 0.515,
      "text": "Vamos a hablar"
    },
    {
      "start": 0.54,
      "end": 1.995,
      "text": "un poquito de cómo"
    },
    {
      "start": 2.02,
      "end": 3.14,
      "text": "pasarnos el hilo dental.",
      "primary_colour": "&H00E560EB"
    },
    {
      "start": 3.32,
      "end": 4.655,
      "text": "Lo primero es la cantidad"
    },
    {
      "start": 4.68,
      "end": 5.755,
      "text": "que vamos a necesitar"
    },
    {
      "start": 5.78,
      "end": 6.5,
      "text": "del hilo dental.",
      "primary_colour": "&H00E560EB"
    },
    {
      "start": 6.62,
      "end": 7.215,
      "text": "Básicamente va a ser"
    },
    {
      "start": 7.24,
      "end": 8.36,
      "text": "el largo de tu brazo."
    },
    {
      "start": 9.08,
      "end": 10.18,
      "text": "Vamos a cogerlo"
    },
    {
      "start": 10.935,
      "end": 11.555,
      "text": "con el corazón",
      "bottom_margin": 1260
    },
    {
      "start": 11.58,
      "end": 13.42,
      "text": "y lo vamos a enrollar",
      "bottom_margin": 1260
    },
    {
      "start": 13.737,
      "end": 14.295,
      "text": "hasta que tengamos",
      "bottom_margin": 1260
    },
    {
      "start": 14.32,
      "end": 16.76,
      "text": "básicamente esto de espacio.",
      "bottom_margin": 1260
    },
    {
      "start": 17.08,
      "end": 17.78,
      "text": "Bien poquito.",
      "bottom_margin": 1260
    },
    {
      "start": 18.6,
      "end": 19.925,
      "text": "Y ahí vamos a bajar",
      "bottom_margin": 1260
    },
    {
      "start": 20.797,
      "end": 21.46,
      "text": "y vamos a llegar",
      "bottom_margin": 1260
    },
    {
      "start": 21.838,
      "end": 23.195,
      "text": "por debajo de la encía",
      "bottom_margin": 1260
    },
    {
      "start": 23.22,
      "end": 24.235,
      "text": "a ambos lados",
      "bottom_margin": 1260
    },
    {
      "start": 24.26,
      "end": 25.76,
      "text": "y a este lado también.",
      "bottom_margin": 1260
    },
    {
      "start": 25.86,
      "end": 26.355,
      "text": "Lo que queremos es",
      "bottom_margin": 1260
    },
    {
      "start": 26.38,
      "end": 27.64,
      "text": "abrazar el diente.",
      "primary_colour": "&H00E560EB",
      "bottom_margin": 1260
    },
    {
      "start": 28.0,
      "end": 29.87,
      "text": "Limpiamos bien, removemos,",
      "bottom_margin": 1260
    },
    {
      "start": 30.014,
      "end": 31.205,
      "text": "el sucio lo guardamos",
      "bottom_margin": 1260
    },
    {
      "start": 31.23,
      "end": 32.31,
      "text": "y liberamos nuevo.",
      "bottom_margin": 1260
    },
    {
      "start": 32.714,
      "end": 34.085,
      "text": "Y volvemos otra vez",
      "bottom_margin": 1260
    },
    {
      "start": 34.11,
      "end": 36.29,
      "text": "y bajamos a ambos lados,",
      "bottom_margin": 1260
