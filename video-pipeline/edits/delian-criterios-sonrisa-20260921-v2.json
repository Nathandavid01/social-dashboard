  "captions": [
    {
      "start": 0.07,
      "end": 1.12,
      "text": "Estas son las tres cosas"
    },
    {
      "start": 1.12,
      "end": 2.3,
      "text": "que evalúo al momento de hacer"
    },
    {
      "start": 2.3,
      "end": 3.26,
      "text": "un diseño de sonrisa"
    },
    {
      "start": 3.26,
      "end": 4.54,
      "text": "en orden de importancia."
    },
    {
      "start": 4.82,
      "end": 5.56,
      "text": "Número uno:"
    },
    {
      "start": 5.76,
      "end": 6.42,
      "text": "la mordida."
    },
    {
      "start": 6.5,
      "end": 7.66,
      "text": "Lo más importante."
    },
    {
      "start": 7.8,
      "end": 8.22,
      "text": "¿Por qué?"
    },
    {
      "start": 8.38,
      "end": 9.18,
      "text": "Porque si tenemos una"
    },
    {
      "start": 9.18,
      "end": 10.28,
      "text": "mordida muy profunda,"
    },
    {
      "start": 10.44,
      "end": 11.44,
      "text": "podemos tumbar entonces"
    },
    {
      "start": 11.44,
      "end": 12.16,
      "text": "los laminados."
    },
    {
      "start": 12.42,
      "end": 13.16,
      "text": "Número dos:"
    },
    {
      "start": 13.487,
      "end": 14.86,
      "text": "la posición de los dientes."
    },
    {
      "start": 15.04,
      "end": 16.08,
      "text": "Bien importante si tenemos"
    },
    {
      "start": 16.08,
      "end": 17.16,
      "text": "un apiñamiento en ellos,"
    },
    {
      "start": 17.16,
      "end": 18.26,
      "text": "porque no queremos"
    },
    {
      "start": 18.26,
      "end": 19.28,
      "text": "desgastar los dientes."
    },
    {
      "start": 19.48,
      "end": 20.22,
      "text": "Y tercero:"
    },
    {
      "start": 20.38,
      "end": 21.32,
      "text": "buscamos una armonización"
    },
    {
      "start": 21.32,
      "end": 21.78,
      "text": "facial,"
    },
    {
      "start": 21.94,
      "end": 22.74,
      "text": "que su diente se vea"
    },
    {
      "start": 22.74,
      "end": 23.82,
      "text": "lo más natural posible."
    },
    {
      "start": 24.02,
      "end": 24.84,
      "text": "Si estás en busca de un"
    },
    {
      "start": 24.84,
      "end": 25.68,
      "text": "diseño de sonrisa,"
    },
    {
      "start": 25.8,
      "end": 26.84,
      "text": "se puede comunicar al"
    },
    {
      "start": 26.84,
      "end": 29.34,
      "text": "787-230-7573"
    }
  ],
