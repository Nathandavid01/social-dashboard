  "captions": [
    {
      "start": 0.14,
      "end": 1.24,
      "text": "Hoy les quiero hablar un poquito"
    },
    {
      "start": 1.24,
      "end": 2.52,
      "text": "de lo que es la gingivitis."
    },
    {
      "start": 2.78,
      "end": 3.48,
      "text": "La gingivitis,"
    },
    {
      "start": 3.48,
      "end": 5.14,
      "text": "la señal primordial es"
    },
    {
      "start": 5.14,
      "end": 6.1,
      "text": "sangrado en la encía."
    },
    {
      "start": 6.44,
      "end": 7.58,
      "text": "¿Qué es lo primero que me preguntan?"
    },
    {
      "start": 7.98,
      "end": 9.5,
      "text": "Doctora, me paso el hilo y sangro."
    },
    {
      "start": 9.83,
      "end": 10.87,
      "text": "Esa es la primera señal."
    },
    {
      "start": 11.27,
      "end": 12.51,
      "text": "No debe haber sangrado."
    },
    {
      "start": 12.83,
      "end": 14.29,
      "text": "¿Qué significa? Inflamación"
    },
    {
      "start": 14.29,
      "end": 14.99,
      "text": "de la encía."
    },
    {
      "start": 15.43,
      "end": 16.77,
      "text": "La respuesta de la encía"
    },
    {
      "start": 16.77,
      "end": 17.89,
      "text": "es sangrar."
    },
    {
      "start": 18.21,
      "end": 19.65,
      "text": "¿Y cómo resolvemos eso?"
    },
    {
      "start": 19.65,
      "end": 21.15,
      "text": "Visitando al dentista."
    },
    {
      "start": 21.35,
      "end": 22.11,
      "text": "Hay veces que podemos verlos"
    },
    {
      "start": 22.11,
      "end": 22.85,
      "text": "cada seis meses,"
    },
    {
      "start": 23.17,
      "end": 24.11,
      "text": "otras veces cada tres."
    },
    {
      "start": 24.59,
      "end": 26.35,
      "text": "Pasamos el hilo dental todos los días,"
    },
    {
      "start": 26.35,
      "end": 28.09,
      "text": "porque si eso no se resuelve,"
    },
    {
      "start": 28.37,
      "end": 30.33,
      "text": "se convierte en periodontitis."
    },
    {
      "start": 30.68,
      "end": 32.04,
      "text": "Y ya ahí vamos a ver"
    },
    {
      "start": 32.04,
      "end": 33.22,
      "text": "una pérdida de hueso."
    },
    {
      "start": 33.68,
      "end": 35.16,
      "text": "Podemos perder hasta los dientes."
    },
    {
      "start": 35.51,
      "end": 37.15,
      "text": "Vamos a tratar de hacer"
    },
    {
      "start": 37.15,
      "end": 38.13,
      "text": "una evaluación completa,"
    },
    {
      "start": 38.93,
      "end": 39.97,
      "text": "ver lo que usted necesita."
    },
    {
      "start": 40.25,
      "end": 41.39,
      "text": "Hacemos limpieza profunda"
    },
    {
      "start": 41.39,
      "end": 42.17,
      "text": "si es necesario."
    },
    {
      "start": 42.51,
      "end": 43.45,
      "text": "Y lo más importante"
    },
    {
      "start": 43.45,
      "end": 44.73,
      "text": "es comunicarse con nosotros al"
    },
    {
      "start": 44.73,
      "end": 47.43,
      "text": "787-230-7573"
    }
  ],
