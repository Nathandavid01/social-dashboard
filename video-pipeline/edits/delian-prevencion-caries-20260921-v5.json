  "captions": [
    {
      "start": 0.16,
      "end": 1.82,
      "text": "¿Sabías que podemos prevenir"
    },
    {
      "start": 2.06,
      "end": 3.04,
      "text": "las caries?"
    },
    {
      "start": 3.28,
      "end": 5.16,
      "text": "Las caries no deben molestarte,"
    },
    {
      "start": 5.3,
      "end": 6.6,
      "text": "a menos que lleguen al nervio."
    },
    {
      "start": 6.7,
      "end": 7.38,
      "text": "Si llegan al nervio,"
    },
    {
      "start": 7.38,
      "end": 8.66,
      "text": "tenemos que hacer un root canal"
    },
    {
      "start": 8.66,
      "end": 9.79,
      "text": "o tenemos que hacer una extracción."
    },
    {
      "start": 9.92,
      "end": 11.36,
      "text": "Son procedimientos más costosos,"
    },
    {
      "start": 11.5,
      "end": 12.24,
      "text": "más tediosos."
    },
    {
      "start": 12.26,
      "end": 13.86,
      "text": "Lo más importante es la prevención."
    },
    {
      "start": 13.98,
      "end": 15.56,
      "text": "Visitar al dentista cada seis meses"
    },
    {
      "start": 15.56,
      "end": 17.3,
      "text": "y por lo menos hacer la limpieza dental."
    },
    {
      "start": 17.59,
      "end": 19.22,
      "text": "Yo soy la doctora Delian Loyola,"
    },
    {
      "start": 19.22,
      "end": 20.02,
      "text": "dentista."
    },
    {
      "start": 20.23,
      "end": 21.35,
      "text": "Si llevas más de seis meses"
    },
    {
      "start": 21.35,
      "end": 22.53,
      "text": "sin visitar a tu dentista"
    },
    {
      "start": 22.63,
      "end": 23.75,
      "text": "o hacerte una limpieza dental,"
    },
    {
      "start": 23.97,
      "end": 25.78,
      "text": "se puede comunicar con nosotros al"
    },
    {
      "start": 25.78,
      "end": 28.73,
      "text": "787-230-7573"
    }
  ],
