    {
      "start": 17.12,
      "end": 19.46,
      "text": "una lámina de cera"
    },
    {
      "start": 19.46,
      "end": 20.4,
      "text": "que se ha puesto"
    },
    {
      "start": 20.4,
      "end": 21.18,
      "text": "anteriormente"
    },
    {
      "start": 21.18,
      "end": 22.04,
      "text": "para que las abejas"
    },
    {
      "start": 22.04,
      "end": 22.7,
      "text": "puedan trabajar"
    },
    {
      "start": 22.7,
      "end": 24.22,
      "text": "un poquito más rápido."
    },
    {
      "start": 24.413,
      "end": 26.493,
      "text": "Tenemos el traje,"
    },
    {
      "start": 26.953,
      "end": 27.973,
      "text": "el mameluco"
    },
    {
      "start": 27.973,
      "end": 28.973,
      "text": "para protegernos"
    },
    {
      "start": 28.973,
      "end": 29.593,
      "text": "de las picaduras"
    },
    {
      "start": 29.593,
      "end": 30.253,
      "text": "de las abejas."
    },
    {
      "start": 30.693,
      "end": 31.733,
      "text": "Tenemos los guantes."
    },
    {
      "start": 32.433,
      "end": 33.673,
      "text": "Tenemos ahumador,"
    },
    {
      "start": 33.743,
      "end": 34.293,
      "text": "que es para"
