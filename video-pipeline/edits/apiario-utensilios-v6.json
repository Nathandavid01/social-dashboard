    },
    {
      "start": 36.0,
      "end": 38.293,
      "text": "Tenemos la feromona,"
    },
    {
      "start": 38.613,
      "end": 39.553,
      "text": "que esto le llaman"
    },
    {
      "start": 39.553,
      "end": 40.213,
