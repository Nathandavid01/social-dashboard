    {
      "start": 40.213,
      "end": 41.033,
      "text": "que se utiliza"
    },
    {
      "start": 41.033,
      "end": 42.113,
      "text": "para traer las abejas"
    },
    {
      "start": 42.113,
      "end": 43.553,
      "text": "a nuestro apiario."
    },
    {
      "start": 43.933,
      "end": 45.233,
      "text": "Estos son otros"
    },
    {
      "start": 45.233,
