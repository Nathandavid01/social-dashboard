    {
      "start": 10.38,
      "end": 11.46,
      "text": "aquí tenemos una caja"
    },
    {
      "start": 11.46,
      "end": 12.2,
      "text": "con su tapa,"
    },
    {
      "start": 12.74,
      "end": 13.82,
      "text": "con sus cuadros,"
    },
    {
      "start": 14.04,
