    {
      "start": 6.2,
      "end": 7.36,
      "text": "de los utensilios"
    },
    {
      "start": 7.36,
      "end": 7.92,
      "text": "que utilizamos"
    },
    {
      "start": 7.92,
      "end": 8.86,
      "text": "para la abeja."
    },
    {
      "start": 9.38,
      "end": 10.38,
      "text": "Por ejemplo,"
