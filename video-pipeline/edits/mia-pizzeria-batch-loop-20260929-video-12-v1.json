  "captions": [
    {
      "start": 0.0,
      "end": 0.75,
      "text": "¿QUÉ ESTÁS COMIENDO?"
    },
    {
      "start": 0.8,
      "end": 1.22,
      "text": "¿PIZZA?"
    },
    {
      "start": 1.4,
      "end": 1.96,
      "text": "NO, NENA."
    },
    {
      "start": 2.0,
      "end": 2.76,
      "text": "ESTOS SON LOS CHICHARRONES"
    },
    {
      "start": 2.76,
      "end": 3.7,
      "text": "DE AQUÍ, DE LA MÍA PIZZA,"
    },
    {
      "start": 3.7,
      "end": 4.92,
      "text": "QUE ESTÁN EN ESPECIALES DE ALMUERZO,"
    },
    {
      "start": 4.92,
      "end": 5.6,
      "text": "DE LUNES A VIERNES,"
    },
    {
      "start": 5.6,
      "end": 6.22,
      "text": "DE 11 A 3."
    },
    {
      "start": 6.34,
      "end": 8.12,
      "text": "ES QUE DICE ARRIBA PIZZA."
    },
    {
      "start": 8.3,
      "end": 9.52,
      "text": "AH, NO, PERO ESA ES LA COSTUMBRE."
    },
    {
      "start": 9.6,
      "end": 10.46,
      "text": "COMO HACEMOS UNAS PIZZAS"
    },
    {
      "start": 10.46,
      "end": 11.76,
      "text": "BIEN BRUTALES, PUES YA TÚ SABES."
    }
  ],
