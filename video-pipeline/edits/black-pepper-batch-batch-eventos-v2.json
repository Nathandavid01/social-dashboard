  "captions": [
    {
      "start": 0.08,
      "end": 1.26,
      "text": "¿Sabías que Black Pepper"
    },
    {
      "start": 1.26,
      "end": 2.26,
      "text": "tiene este espacio"
    },
    {
      "start": 2.26,
      "end": 3.6,
      "text": "para ti?"
    },
    {
      "start": 3.6,
      "end": 4.9,
      "text": "Celebramos cumpleaños,"
    },
    {
      "start": 4.9,
      "end": 5.92,
      "text": "actividades privadas,"
    },
    {
      "start": 5.92,
      "end": 6.96,
      "text": "corporativas"
    },
    {
      "start": 6.96,
      "end": 8.24,
      "text": "y tenemos esta barra"
    },
    {
      "start": 8.24,
      "end": 9.62,
      "text": "disponible para"
    },
    {
      "start": 9.62,
      "end": 10.58,
      "text": "los comensales."
    },
    {
      "start": 10.65,
      "end": 11.73,
      "text": "Tenemos esta área aquí"
    },
    {
      "start": 11.73,
      "end": 12.58,
      "text": "que es nuestra sala."
    },
    {
      "start": 12.64,
      "end": 14.02,
      "text": "Mucha gente se viene"
    },
    {
      "start": 14.02,
      "end": 14.84,
      "text": "aquí los viernes"
    },
    {
      "start": 14.84,
      "end": 15.58,
      "text": "en la noche."
    },
    {
      "start": 15.58,
      "end": 16.78,
      "text": "Tienen la musiquita,"
    },
    {
      "start": 17.08,
      "end": 18.38,
      "text": "ahí tienen la mesita"
    },
    {
      "start": 18.56,
      "end": 19.28,
      "text": "para sentirnos,"
    },
    {
      "start": 19.28,
      "end": 20.28,
      "text": "mira, como en casa"
    },
    {
      "start": 20.28,
      "end": 20.8,
      "text": "y vivir una"
    },
    {
      "start": 20.8,
      "end": 21.48,
      "text": "experiencia única"
    },
    {
      "start": 21.48,
      "end": 22.38,
      "text": "que te lo regala,"
    },
    {
      "start": 22.44,
      "end": 23.34,
      "text": "¿sabes quién?"
    },
    {
      "start": 23.34,
      "end": 23.98,
      "text": "Black Pepper."
    }
