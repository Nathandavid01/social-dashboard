  "captions": [
    {
      "start": 0.02,
      "end": 1.01,
      "text": "YO SOY LA JEFA."
    },
    {
      "start": 1.08,
      "end": 2.18,
      "text": "SOY MANDONA Y SÍ,"
    },
    {
      "start": 2.22,
      "end": 2.89,
      "text": "ME CREO SU MAMÁ."
    },
    {
      "start": 2.94,
      "end": 3.68,
      "text": "PERO TODO POR USTEDES,"
    },
    {
      "start": 3.68,
      "end": 4.78,
      "text": "PORQUE USTEDES\nSE LO MERECEN."
    },
    {
      "start": 4.88,
      "end": 5.58,
      "text": "NO TE OLVIDES QUE ESTAMOS"
    },
    {
      "start": 5.58,
      "end": 6.74,
      "text": "CERCA DEL PUENTE\nDE RÍO HONDO,"
    },
    {
      "start": 6.8,
      "end": 7.56,
      "text": "AL FRENTE DE\nSWEET ANN CAKES."
    },
    {
      "start": 7.6,
      "end": 8.48,
      "text": "AQUÍ EN LA MÍA PIZZA."
    },
    {
      "start": 8.5,
      "end": 9.14,
      "text": "¡TE ESPERAMOS!"
    }
  ],
