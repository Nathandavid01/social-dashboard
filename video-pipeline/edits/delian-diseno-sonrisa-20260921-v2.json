  "captions": [
    {
      "start": 0.06,
      "end": 0.9,
      "text": "¿Qué realmente es un"
    },
    {
      "start": 0.9,
      "end": 1.76,
      "text": "diseño de sonrisa?"
    },
    {
      "start": 2.06,
      "end": 2.92,
      "text": "Cuando pensabas en un"
    },
    {
      "start": 2.92,
      "end": 3.62,
      "text": "diseño de sonrisa"
    },
    {
      "start": 3.62,
      "end": 5.02,
      "text": "pensabas rápidamente en"
    },
    {
      "start": 5.02,
      "end": 5.96,
      "text": "hacernos los dientes."
    },
    {
      "start": 7.16,
      "end": 7.64,
      "text": "En carillas,"
    },
    {
      "start": 7.64,
      "end": 8.22,
      "text": "laminados,"
    },
    {
      "start": 8.8,
      "end": 9.5,
      "text": "y va mucho más"
    },
    {
      "start": 9.5,
      "end": 9.96,
      "text": "de eso."
    },
    {
      "start": 9.96,
      "end": 11.1,
      "text": "Tenemos que mirar todo"
    },
    {
      "start": 11.1,
      "end": 11.8,
      "text": "el rostro,"
    },
    {
      "start": 11.8,
      "end": 12.62,
      "text": "los labios,"
    },
    {
      "start": 12.66,
      "end": 13.56,
      "text": "las encías,"
    },
    {
      "start": 13.66,
      "end": 15.14,
      "text": "sobre todo la mordida."
    },
    {
      "start": 15.58,
      "end": 15.94,
      "text": "Para entonces,"
    },
    {
      "start": 15.94,
      "end": 17.12,
      "text": "puedes crear una sonrisa"
    },
    {
      "start": 17.12,
      "end": 17.72,
      "text": "armoniosa.",
      "primary_colour": "&H00E560EB"
    }
  ],
