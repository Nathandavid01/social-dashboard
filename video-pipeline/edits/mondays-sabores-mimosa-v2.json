    {
      "start": 0.0,
      "end": 3.4,
      "text": "¿Sabías que\nen Mondays Aguadilla\ntenemos sabores\nde mimosa?"
    },
    {
      "start": 3.52,
      "end": 7.4,
      "text": "De china, de acerola,\nde parcha, de melón,"
    },
    {
      "start": 7.58,
      "end": 10.1,
      "text": "de fresa, de toronja\ny de cranberry."
    },
    {
      "start": 10.26,
      "end": 11.4,
      "text": "Lo que tú gustes."
    },
    {
      "start": 11.64,
      "end": 14.7,
      "text": "Recuerden, carretera 459,\nAguadilla."
    }
  ],
  "review_notes": [
