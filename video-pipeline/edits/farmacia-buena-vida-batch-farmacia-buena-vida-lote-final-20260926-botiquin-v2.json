  "captions": [
    {
      "start": 0.13,
      "end": 1.01,
      "text": "Bueno, familia,"
    },
    {
      "start": 1.09,
      "end": 2.28,
      "text": "llegó la temporada de huracanes."
    },
    {
      "start": 2.35,
      "end": 3.87,
      "text": "Estas son algunas cositas"
    },
    {
      "start": 3.87,
      "end": 6.0,
      "text": "que puedes tener de primera mano:"
    },
    {
      "start": 6.09,
      "end": 7.1,
      "text": "agua potable,"
    },
    {
      "start": 7.33,
      "end": 8.75,
      "text": "medicamentos al día,"
    },
    {
      "start": 8.83,
      "end": 9.67,
      "text": "alguna mochilita"
    },
    {
      "start": 9.67,
      "end": 10.88,
      "text": "que tengamos, ¿verdad?,"
    },
    {
      "start": 10.97,
      "end": 12.59,
      "text": "disponible en la farmacia,"
    },
    {
      "start": 12.59,
      "end": 13.37,
      "text": "que puedas adicionarle"
    },
    {
      "start": 13.37,
      "end": 15.31,
      "text": "tus artículos de primera necesidad."
    },
    {
      "start": 15.39,
      "end": 17.68,
      "text": "También tenemos linternas o velas."
    },
    {
      "start": 17.89,
      "end": 19.13,
      "text": "Así que aquí los esperamos"
    },
    {
      "start": 19.13,
      "end": 20.21,
      "text": "para que puedas conseguir"
    },
    {
      "start": 20.21,
      "end": 21.93,
      "text": "todas esas cositas que necesitas."
    }
  ],
