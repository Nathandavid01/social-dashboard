  "captions": [
    {
      "start": 0.06,
      "end": 2.52,
      "text": "Oye, doctora, ¿qué yo necesito previo un diseño",
      "back_colour": "&H00252525"
    },
    {
      "start": 2.52,
      "end": 5.18,
      "text": "de sonrisa? Lo primero es una buena salud oral."
    },
    {
      "start": 5.26,
      "end": 6.56,
      "text": "Si hay inflamación de las encías,"
    },
    {
      "start": 6.68,
      "end": 7.94,
      "text": "tenemos primero que trabajar eso"
    },
    {
      "start": 7.94,
      "end": 9.34,
      "text": "para entonces hacer un diseño de"
    },
    {
      "start": 9.34,
      "end": 11.64,
      "text": "sonrisa. Dos: y bien importante,"
    },
    {
      "start": 11.94,
      "end": 13.08,
      "text": "la posición de los dientes."
    },
    {
      "start": 13.1,
      "end": 15.16,
      "text": "Hay apiñamiento, mi recomendación es que primero"
    },
    {
      "start": 15.16,
      "end": 16.64,
      "text": "trabajemos con braces o con"
    },
    {
      "start": 16.64,
      "end": 18.86,
      "text": "Invisalign y luego entonces hacer el"
    },
    {
      "start": 18.86,
      "end": 19.8,
      "text": "diseño de sonrisa."
    },
    {
      "start": 19.94,
      "end": 21.18,
      "text": "Para cualquiera de estos servicios"
    },
    {
      "start": 21.18,
      "end": 22.94,
      "text": "se puede comunicar con nosotros al"
    },
    {
      "start": 22.94,
      "end": 25.64,
      "text": "787-230-7573"
    }
  ],
