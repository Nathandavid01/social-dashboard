      "text": "un diseño de sonrisa?",
      "back_colour": "&H00000000"
    },
    {
      "start": 2.086,
      "end": 2.74,
      "text": "Cuando pensamos en"
    },
    {
      "start": 2.76,
      "end": 3.5,
      "text": "un diseño de sonrisa,"
    },
    {
      "start": 3.52,
      "end": 4.5,
      "text": "pensamos rápidamente"
    },
    {
      "start": 4.52,
      "end": 6.01,
      "text": "en hacernos los dientes,"
    },
    {
      "start": 6.1,
      "end": 7.1,
      "text": "en carillas,"
    },
    {
      "start": 7.12,
      "end": 8.3,
      "text": "en laminados,"
    },
    {
      "start": 8.449,
      "end": 9.61,
      "text": "y va mucho más que eso."
    },
    {
      "start": 9.63,
      "end": 10.51,
      "text": "Tenemos que mirar"
    },
    {
      "start": 10.538,
      "end": 11.43,
      "text": "todo el rostro,"
    },
    {
      "start": 11.45,
      "end": 12.27,
      "text": "los labios,"
    },
    {
      "start": 12.29,
      "end": 13.32,
      "text": "las encías,"
    },
    {
      "start": 13.35,
      "end": 15.0,
      "text": "sobre todo la mordida,"
    },
    {
      "start": 15.074,
      "end": 15.89,
      "text": "para entonces poder crear"
    },
    {
      "start": 15.91,
      "end": 17.4,
      "text": "una sonrisa armoniosa."
