  "captions": [
    {
      "start": 0.02,
      "end": 1.06,
      "text": "Doctora, ¿qué pasa si",
      "bottom_margin": 230,
      "back_colour": "&H00252525"
    },
    {
      "start": 1.06,
      "end": 2.22,
      "text": "pierdo un diente de adulto?",
      "bottom_margin": 230,
      "back_colour": "&H00252525"
    },
    {
      "start": 2.46,
      "end": 3.76,
      "text": "Bueno, lo más importante es tratar",
      "bottom_margin": 230
    },
    {
      "start": 3.76,
      "end": 4.86,
      "text": "de reemplazar, ¿verdad?",
      "bottom_margin": 230
    },
    {
      "start": 5.1,
      "end": 6.72,
      "text": "Ese diente que hemos perdido,",
      "bottom_margin": 230
    },
    {
      "start": 6.94,
      "end": 7.9,
      "text": "porque los dientes se van a mover.",
      "bottom_margin": 230
    },
    {
      "start": 8.22,
      "end": 10.76,
      "text": "Podemos ver aquí un caso",
      "bottom_margin": 230
    },
    {
      "start": 10.76,
      "end": 13.68,
      "text": "en donde ya la paciente tuvo Invisalign.",
      "bottom_margin": 230
    },
    {
      "start": 13.82,
      "end": 16.18,
      "text": "Estas piezas estaban bien inclinadas.",
      "bottom_margin": 230
    },
    {
      "start": 16.48,
      "end": 17.54,
      "text": "Al estar bien inclinadas,",
      "bottom_margin": 230
    },
    {
      "start": 17.68,
      "end": 18.9,
      "text": "no tengo suficiente espacio",
      "bottom_margin": 230
    },
    {
      "start": 18.9,
      "end": 20.14,
      "text": "para poderlos reemplazar.",
      "bottom_margin": 230
    },
    {
      "start": 20.48,
      "end": 22.66,
      "text": "Y hacer un puente o un implante.",
      "bottom_margin": 230
    },
    {
      "start": 22.66,
      "end": 26.46,
      "text": "Aquí ya preparamos",
      "bottom_margin": 230
    },
    {
      "start": 26.46,
      "end": 28.12,
      "text": "para colocar entonces",
      "bottom_margin": 230
    },
    {
      "start": 28.12,
      "end": 29.7,
      "text": "un puente fijo.",
      "bottom_margin": 230
    },
    {
      "start": 29.92,
      "end": 31.72,
      "text": "La otra opción sería un implante,",
      "bottom_margin": 230
    },
    {
      "start": 31.8,
      "end": 32.64,
      "text": "que es el tornillo",
      "bottom_margin": 230
    },
    {
      "start": 32.64,
      "end": 34.48,
      "text": "o algo removible.",
      "bottom_margin": 230
    },
    {
      "start": 34.74,
      "end": 36.46,
      "text": "Todos esos servicios los brindamos aquí,",
      "bottom_margin": 230
    },
    {
      "start": 36.56,
      "end": 38.08,
      "text": "así que se pueden comunicar al",
      "bottom_margin": 230
    },
    {
      "start": 38.08,
      "end": 40.54,
      "text": "787-230-7573",
      "bottom_margin": 230
    }
  ],
