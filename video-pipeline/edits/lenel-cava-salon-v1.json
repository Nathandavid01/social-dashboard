  "captions": [
    {"start": 0.18, "end": 2.26, "text": "Amantes del vino,\nesta es nuestra cava de vino."},
    {"start": 2.82, "end": 4.14, "text": "Aquí tenemos una selección de vinos."},
    {"start": 4.24, "end": 6.28, "text": "Tenemos franceses,\ncalifornianos e italianos."},
    {"start": 7.18, "end": 11.66, "text": "Y aparte de los vinos, este salón\nse utiliza para actividades privadas."},
    {"start": 12.2, "end": 14.66, "text": "Tiene capacidad de 20 a 25 personas."},
