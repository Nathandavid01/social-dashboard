  "captions": [
    {
      "start": 0.04,
      "end": 1.3,
      "text": "Cuéntame, ¿por qué Yabuuchi?"
    },
    {
      "start": 1.5,
      "end": 2.16,
      "text": "Pues mira,"
    },
    {
      "start": 2.18,
      "end": 3.18,
      "text": "nuestro nombre es Yabuuchi"
    },
    {
      "start": 3.2,
      "end": 4.28,
      "text": "en honor a Keiko Yabuuchi,"
    },
    {
      "start": 4.3,
      "end": 6.13,
      "text": "quien fue la mujer pionera"
    },
    {
      "start": 6.13,
      "end": 7.16,
      "text": "en sushi aquí en Puerto Rico,"
    },
    {
      "start": 7.24,
      "end": 8.5,
      "text": "quien le enseñó a Carlos Santiago,"
    },
    {
      "start": 8.6,
      "end": 9.42,
      "text": "el dueño de la marca,"
    },
    {
      "start": 9.76,
      "end": 10.86,
      "text": "durante 14 años"
    },
    {
      "start": 10.86,
      "end": 11.96,
      "text": "el arte de hacer sushi."
    },
    {
      "start": 11.966667,
      "end": 14.166667,
      "text": "Y por si no lo sabías,"
    },
    {
      "start": 14.366667,
      "end": 15.146667,
      "text": "estamos en la avenida"
    },
    {
      "start": 15.146667,
      "end": 15.806667,
      "text": "Dos Palmas,"
    },
    {
      "start": 15.846667,
      "end": 16.606667,
      "text": "aquí en Levittown,"
    },
    {
      "start": 16.766667,
      "end": 17.286667,
      "text": "y contamos con"
    },
    {
      "start": 17.286667,
      "end": 18.066667,
      "text": "amplio estacionamiento"
    },
    {
      "start": 18.066667,
      "end": 19.746667,
      "text": "al frente y atrás para los clientes."
    }
  ],
