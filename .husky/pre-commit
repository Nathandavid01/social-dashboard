#!/usr/bin/env sh
# REGLA DEL REPO: no entra un commit sin haberlo validado contra el staging.
# typecheck -> unit -> E2E contra staging (nunca producción: lo verifica
# scripts/check-staging-env.mjs antes de levantar nada).
#
# No hay escape. Si no tienes .env.staging, móntalo: docs/STAGING.md.
# `git commit --no-verify` se salta ESTE hook, pero no el job `e2e` del PR:
# main solo acepta cambios con ese check verde.

set -e

echo "› typecheck"
npx tsc --noEmit

echo "› unit tests"
npx vitest run --exclude '**/.claude/**' --exclude '**/*.live.test.ts'

echo "› E2E en staging"
npm run test:e2e
