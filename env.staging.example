# Copiar a .env.staging (ignorado por git). Ver docs/STAGING.md.
# OJO: proyecto Supabase de STAGING, nunca el de producción.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-de-staging>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key de staging>
SUPABASE_SERVICE_ROLE_KEY=<service role de staging>

# Usuario que crean/reusan los E2E (lo siembra scripts/seed-staging.mjs)
E2E_USER_EMAIL=e2e@natemedia.test
E2E_USER_PASSWORD=<contraseña larga>
